<script>
 document.addEventListener("DOMContentLoaded", function() {
 let seats = JSON.parse(localStorage.getItem('ticketbox_seats')) || ['D5', 'D6'];
 document.getElementById('history-seats').innerText = seats.join(', ');
 
 let total = seats.length * 90000;
 document.getElementById('history-total').innerText = total.toLocaleString('vi-VN');
 });
</script>
