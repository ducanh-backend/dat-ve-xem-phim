<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Quản Lý Thể Loại - Admin Ticket Box'); ?>
<?php $this->startSection('page_title', 'DANH SÁCH THỂ LOẠI PHIM'); ?>

<?php $this->startSection('content'); ?>
<div class="card card-custom p-4 shadow-sm">
 <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
 <div>
 <h5 class="text-dark mb-1 fw-bold">Tất Cả Thể Loại Phim</h5>
 <span class="text-secondary small">Tổng cộng: <strong class="text-primary"><?php echo \htmlentities(count($categories)??'', ENT_QUOTES, 'UTF-8', false); ?></strong> thể loại</span>
 </div>
 <?php if(($_SESSION['user']['role'] ?? '') === 'admin'): ?>
 <a href="/ASSGD1/admin/categories/create" class="btn btn-warning fw-bold text-white shadow-sm">
 <i class="bi bi-plus-circle-fill me-1"></i> Thêm Thể Loại Mới
 </a>
 <?php else: ?>
 <span class="badge bg-secondary p-2"><i class="bi bi-eye-fill me-1"></i> Quyền Xem Dữ Liệu</span>
 <?php endif; ?>
 </div>

 <div class="table-responsive">
 <table class="table table-dark-custom table-hover align-middle mb-0">
 <thead>
 <tr>
 <th style="width: 80px;">ID</th>
 <th>Tên Thể Loại</th>
 <th>Slug Đường Dẫn</th>
 <th>Mô Tả Chi Tiết</th>
 <th style="width: 180px;" class="text-center">Thao Tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($categories)): ?>
 <tr>
 <td colspan="5" class="text-center text-secondary py-5">
 <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
 Chưa có thể loại nào được tạo. Hãy nhấn "Thêm Thể Loại Mới" ở trên!
 </td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $cat): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td class="text-secondary fw-semibold">#<?php echo \htmlentities($cat->id??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="fw-bold text-dark fs-6"><?php echo \htmlentities($cat->name??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><span class="badge bg-secondary"><?php echo \htmlentities($cat->slug??'', ENT_QUOTES, 'UTF-8', false); ?></span></td>
 <td class="text-secondary small"><?php echo \htmlentities($cat->description ?? 'Chưa có mô tả'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-center">
 <?php if(($_SESSION['user']['role'] ?? '') === 'admin'): ?>
 <a href="/ASSGD1/admin/categories/edit/<?php echo \htmlentities($cat->id??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-outline-warning me-1">
 <i class="bi bi-pencil-square me-1"></i> Sửa
 </a>
 <a href="/ASSGD1/admin/categories/delete/<?php echo \htmlentities($cat->id??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 class="btn btn-sm btn-outline-danger" 
 onclick="return confirm('Bạn có chắc chắn muốn xóa thể loại [<?php echo \htmlentities($cat->name??'', ENT_QUOTES, 'UTF-8', false); ?>]?')">
 <i class="bi bi-trash me-1"></i> Xóa
 </a>
 <?php else: ?>
 <span class="text-muted small"><i class="bi bi-lock-fill me-1"></i> Chỉ xem</span>
 <?php endif; ?>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('admin.layout.app'); } ?>