<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Chỉnh Sửa & Phân Quyền Người Dùng - Admin Ticket Box'); ?>
<?php $this->startSection('page_title', 'CHỈNH SỬA & PHÂN QUYỀN NGƯỜI DÙNG'); ?>

<?php $this->startSection('content'); ?>
<div class="row justify-content-center">
 <div class="col-lg-8">
 <div class="card card-custom p-4 shadow-lg">
 <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
 <div>
 <h5 class="text-warning mb-1 fw-bold">Chỉnh sửa tài khoản: #<?php echo \htmlentities(str_pad($user->id, 4, '0', STR_PAD_LEFT)??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($user->name??'', ENT_QUOTES, 'UTF-8', false); ?></h5>
 <p class="text-muted small mb-0">Cập nhật thông tin, thay đổi mật khẩu hoặc phân cấp vai trò quản trị</p>
 </div>
 <a href="/ASSGD1/admin/users" class="btn btn-outline-warning btn-sm">
 <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
 </a>
 </div>

 <form action="/ASSGD1/admin/users/edit/<?php echo \htmlentities($user->id??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <div class="row g-3 mb-3">
 <div class="col-md-6">
 <label class="form-label">Họ và Tên <span class="text-danger">*</span></label>
 <input type="text" name="name" class="form-control <?php echo \htmlentities(!empty($error['name']) ? 'is-invalid' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 value="<?php echo \htmlentities($_POST['name'] ?? $user->name??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 <?php if(!empty($error['name'])): ?>
 <div class="invalid-feedback"><?php echo \htmlentities($error['name']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </div>
 <div class="col-md-6">
 <label class="form-label">Email Tài Khoản <span class="text-danger">*</span></label>
 <input type="email" name="email" class="form-control <?php echo \htmlentities(!empty($error['email']) ? 'is-invalid' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 value="<?php echo \htmlentities($_POST['email'] ?? $user->email??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 <?php if(!empty($error['email'])): ?>
 <div class="invalid-feedback"><?php echo \htmlentities($error['email']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </div>
 </div>

 <div class="row g-3 mb-3">
 <div class="col-md-6">
 <label class="form-label">Số Điện Thoại</label>
 <input type="tel" name="phone" class="form-control <?php echo \htmlentities(!empty($error['phone']) ? 'is-invalid' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 placeholder="0912345678" value="<?php echo \htmlentities($_POST['phone'] ?? ($user->phone ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if(!empty($error['phone'])): ?>
 <div class="invalid-feedback"><?php echo \htmlentities($error['phone']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </div>
 <div class="col-md-6">
 <label class="form-label">Mật Khẩu Mới (Tùy chọn)</label>
 <input type="password" name="password" class="form-control <?php echo \htmlentities(!empty($error['password']) ? 'is-invalid' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 placeholder="Để trống nếu không muốn đổi mật khẩu">
 <?php if(!empty($error['password'])): ?>
 <div class="invalid-feedback"><?php echo \htmlentities($error['password']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 <div class="form-text text-muted small mt-1">Chỉ điền khi muốn đặt lại mật khẩu cho người dùng này.</div>
 </div>
 </div>

 <!-- Phân Quyền Vai Trò -->
 <div class="mb-4 p-3 rounded" style="background-color: #0c0f17; border: 1.5px solid #2a3349;">
 <div class="d-flex justify-content-between align-items-center mb-2">
 <label class="form-label fw-bold text-warning mb-0">
 <i class="bi bi-shield-shaded me-1"></i> Phân Quyền Vai Trò (Role) <span class="text-danger">*</span>
 </label>
 <?php if($user->id == $_SESSION['user']['id']): ?>
 <span class="badge bg-warning text-dark small">Tài khoản của bạn (Không thể tự hạ quyền)</span>
 <?php endif; ?>
 </div>

 <?php if(!empty($error['role'])): ?>
 <div class="alert alert-danger py-1 px-2 small mb-3"><?php echo \htmlentities($error['role']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>

 <?php 
 $currentRole = $_POST['role'] ?? $user->role;
 ?>

 <div class="row g-3">
 <div class="col-md-6">
 <div class="form-check p-3 rounded" style="background-color: #141824; border: 1px solid #2a3349;">
 <input class="form-check-input" type="radio" name="role" id="role_user" value="user" 
 <?php echo \htmlentities($currentRole === 'user' ? 'checked' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php echo \htmlentities($user->id == $_SESSION['user']['id'] ? 'disabled' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <label class="form-check-label d-block ms-2" for="role_user">
 <strong class="text-success"><i class="bi bi-person-check me-1"></i> Khách Hàng (User)</strong>
 <div class="text-muted small mt-1">Thành viên thông thường: đặt vé, xem phim, quản lý vé cá nhân.</div>
 </label>
 </div>
 </div>
 <div class="col-md-6">
 <div class="form-check p-3 rounded" style="background-color: #141824; border: 1px solid #2a3349;">
 <input class="form-check-input" type="radio" name="role" id="role_admin" value="admin"
 <?php echo \htmlentities($currentRole === 'admin' ? 'checked' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <label class="form-check-label d-block ms-2" for="role_admin">
 <strong class="text-danger"><i class="bi bi-shield-lock me-1"></i> Quản Trị Viên (Admin)</strong>
 <div class="text-muted small mt-1">Toàn quyền truy cập bảng điều khiển Admin, quản lý phim và người dùng.</div>
 </label>
 </div>
 </div>
 </div>
 </div>

 <div class="d-flex justify-content-end gap-2">
 <a href="/ASSGD1/admin/users" class="btn btn-outline-secondary px-3">Hủy bỏ</a>
 <button type="submit" class="btn btn-warning fw-bold px-4">
 <i class="bi bi-check2-circle me-1"></i> Lưu Cập Nhật
 </button>
 </div>
 </form>
 </div>
 </div>
</div>
