 <img src="<?php echo \htmlentities($posterUrl??'', ENT_QUOTES, 'UTF-8', false); ?>" class="img-fluid rounded-3 w-100" style="max-height: 520px; object-fit: cover;" alt="<?php echo \htmlentities($movie->title??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>
 </div>
 <div class="col-md-8">
 <div class="card card-custom p-4 h-100">
 <h1 class="fw-bold mb-3 text-dark"><?php echo \htmlentities($movie->title??'', ENT_QUOTES, 'UTF-8', false); ?></h1>
 
 <div class="d-flex flex-wrap gap-3 mb-4 p-3 rounded-3 bg-light border">
 <div>
 <span class="text-secondary small d-block">Đạo diễn</span>
 <strong class="text-dark"><?php echo \htmlentities($movie->director ?? 'Đang cập nhật'??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 </div>
 <div class="border-start ps-3">
 <span class="text-secondary small d-block">Thời lượng</span>
 <strong class="text-dark"><?php echo \htmlentities($movie->duration??'', ENT_QUOTES, 'UTF-8', false); ?> Phút</strong>
 </div>
 <div class="border-start ps-3">
 <span class="text-secondary small d-block">Khởi chiếu</span>
 <strong class="text-dark"><?php echo \htmlentities($movie->release_date ?? 'Đang chiếu'??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 </div>
 <div class="border-start ps-3">
 <span class="text-secondary small d-block">Trạng thái</span>
 <span class="badge <?php echo \htmlentities($movie->status == 'dang_chieu' ? 'bg-success' : 'bg-secondary'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($movie->status == 'dang_chieu' ? 'Đang chiếu' : 'Sắp chiếu'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </div>
 </div>
 
 <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Nội dung phim</h5>
 <p class="text-secondary" style="line-height: 1.8; font-size: 1.05rem;">
 <?php echo \htmlentities($movie->description ?? 'Đang cập nhật nội dung...'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </p>

 <?php if(!empty($movie->trailer_url)): ?>
 <h5 class="fw-bold text-dark border-bottom pb-2 mt-4 mb-3">Trailer chính thức</h5>
 <div class="ratio ratio-16x9 mb-4 rounded-3 overflow-hidden border shadow-sm">
 <iframe src="<?php echo \htmlentities($movie->trailer_url??'', ENT_QUOTES, 'UTF-8', false); ?>" title="YouTube video" allowfullscreen></iframe>
 </div>
 <?php endif; ?>

 <div class="mt-auto pt-3">
 <a href="/ASSGD1/booking/seat?movie_id=<?php echo \htmlentities($movie->id??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-warning btn-lg fw-bold w-100 py-3 fs-5 shadow text-white">
 <i class="bi bi-ticket-detailed-fill me-2"></i> MUA VÉ NGAY
 </a>
 </div>
 </div>
 </div>
 </div>
