<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Đăng Nhập Quản Trị & Khách Hàng'); ?>

<?php $this->startSection('content'); ?>
<div class="row justify-content-center my-5">
 <div class="col-md-5 col-lg-4">
 <div class="card card-custom p-4 shadow-sm">
 <div class="card-body">
 <div class="text-center mb-4">
 <div class="d-inline-flex p-3 rounded-circle bg-light border text-primary mb-3 fs-3">
 <i class="bi bi-film"></i>
 </div>
 <h3 class="fw-bold mb-1 text-dark">ĐĂNG NHẬP</h3>
 <p class="text-secondary small">Hệ thống đặt vé và quản trị VNBox Cinema</p>
 </div>

 <?php if(!empty($error)): ?>
 <div class="alert alert-danger py-2 small border-0 d-flex align-items-center mb-3" role="alert">
 <i class="bi bi-exclamation-circle me-2"></i> <?php echo \htmlentities($error??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 <?php endif; ?>

 <?php if(!empty($message)): ?>
 <div class="alert alert-success py-2 small border-0 d-flex align-items-center mb-3" role="alert">
 <i class="bi bi-check-circle me-2"></i> <?php echo \htmlentities($message??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 <?php endif; ?>

 <form action="/ASSGD1/login" method="POST">
 <div class="mb-3">
 <label for="email" class="form-label">Email đăng nhập</label>
 <input type="email" class="form-control" id="email" name="email" 
 placeholder="admin@gmail.com" required value="<?php echo \htmlentities(!empty($registered_email) ? $registered_email : ($_POST['email'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>

 <div class="mb-4">
 <label for="password" class="form-label">Mật khẩu</label>
 <input type="password" class="form-control" id="password" name="password" 
 placeholder="••••••••" required>
 </div>

 <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mb-3 text-white shadow-sm">
 <i class="bi bi-box-arrow-in-right me-1"></i> ĐĂNG NHẬP NGAY
 </button>
 </form>

 <div class="text-center mt-3 pt-3 border-top">
 <span class="text-secondary small">Chưa có tài khoản Ticket Box? </span>
 <a href="/ASSGD1/register" class="text-primary fw-bold text-decoration-none small">
 Đăng ký ngay <i class="bi bi-arrow-right"></i>
 </a>
 </div>
 </div>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

