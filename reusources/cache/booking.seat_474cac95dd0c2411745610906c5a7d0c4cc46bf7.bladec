<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Chọn Ghế - Ticket Box'); ?>

<?php $this->startSection('content'); ?>
<div class="text-center mb-5">
 <h2 class="text-warning">CHỌN GHẾ NGỒI</h2>
 <p class="text-muted">Phim: <strong>SIÊU ANH HÙNG TRỞ LẠI</strong> | Suất chiếu: <strong>19:30 - Hôm nay</strong></p>
</div>

<div class="row justify-content-center">
 <div class="col-md-8 glass p-5 rounded-4">
 <!-- Màn hình chiếu sáng Neon -->
 <div class="screen-glow"></div>
 <div class="text-center text-warning fw-bold mb-5 fs-5">MÀN HÌNH CHÍNH</div>

 <!-- Sơ đồ ghế -->
 <div class="d-flex flex-column align-items-center gap-2">
 <?php $__currentLoopData = ['A', 'B', 'C', 'D', 'E']; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $row): $loop = $this->incrementLoopIndices();  ?>
 <div class="d-flex gap-2 align-items-center">
 <strong class="me-3"><?php echo \htmlentities($row??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 <?php for($col = 1; $col <= 10; $col++): ?>
 <?php 
 // Logic ghế VIP và Thường
 $isVIP = ($row == 'C' || $row == 'D');
 $price = $isVIP ? 120000 : 90000;
 $colorClass = $isVIP ? 'border-info text-info' : 'border-secondary text-white';

 // Vài ghế đã được mua tĩnh
 $isBooked = ($row == 'B' && $col == 5) || ($row == 'C' && $col == 7) || ($row == 'D' && $col == 4);
 ?>

 <?php if($isBooked): ?>
 <div class="seat bg-danger rounded text-center text-white p-1" style="width: 35px; height: 35px; opacity: 0.5; cursor: not-allowed; font-size: 12px; line-height: 25px;"><?php echo \htmlentities($col??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php else: ?>
 <!-- Ghế trống -->
 <div class="seat seat-available bg-dark rounded text-center p-1 border seat-hover <?php echo \htmlentities($colorClass??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 data-seat="<?php echo \htmlentities($row??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities($col??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 data-price="<?php echo \htmlentities($price??'', ENT_QUOTES, 'UTF-8', false); ?>"
 data-type="<?php echo \htmlentities($isVIP ? 'VIP' : 'Thường'??'', ENT_QUOTES, 'UTF-8', false); ?>"
 style="width: 35px; height: 35px; cursor: pointer; font-size: 12px; line-height: 25px;"><?php echo \htmlentities($col??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 <?php endfor; ?>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>

 <!-- Chú thích -->
 <div class="d-flex justify-content-center gap-4 mt-5">
 <div class="d-flex align-items-center"><div class="bg-dark border border-secondary rounded me-2" style="width: 20px; height: 20px;"></div> Thường (90k)</div>
 <div class="d-flex align-items-center"><div class="bg-dark border border-info rounded me-2" style="width: 20px; height: 20px;"></div> VIP (120k)</div>
 <div class="d-flex align-items-center"><div class="bg-warning rounded me-2" style="width: 20px; height: 20px;"></div> Đang chọn</div>
 <div class="d-flex align-items-center"><div class="bg-danger rounded me-2" style="width: 20px; height: 20px; opacity: 0.5;"></div> Đã bán</div>
 </div>
 
 <!-- Hiển thị ghế đang chọn -->
 <div class="mt-4 text-center">
 <h5 class="text-white">Ghế đang chọn: <span id="selected-seats-display" class="text-warning">Chưa chọn ghế</span></h5>
 <h5 class="text-white mt-2">Tạm tính: <span id="temp-total" class="text-success fw-bold">0</span> VNĐ</h5>
 </div>

 <div class="text-center mt-5">
 <a href="/ASSGD1/movie/1" class="btn btn-outline-secondary me-2">Quay lại</a>
 <a href="/ASSGD1/booking/checkout" id="btn-checkout" class="btn btn-warning px-5 fw-bold">TIẾP TỤC THANH TOÁN</a>
 </div>
 </div>
</div>

<script>
 document.addEventListener("DOMContentLoaded", function() {
 const availableSeats = document.querySelectorAll('.seat-available');
 const displaySpan = document.getElementById('selected-seats-display');
 const displayTotal = document.getElementById('temp-total');
 const btnCheckout = document.getElementById('btn-checkout');
 let selectedSeats = [];

 localStorage.removeItem('ticketbox_seats');

 availableSeats.forEach(seat => {
 seat.addEventListener('click', function() {
 const seatId = this.getAttribute('data-seat');
 const seatPrice = parseInt(this.getAttribute('data-price'));
 const seatType = this.getAttribute('data-type');
 
 this.classList.toggle('bg-warning');
 this.classList.toggle('text-dark');
 this.classList.toggle('fw-bold');
 this.classList.toggle('bg-dark');
 
 const isSelected = this.classList.contains('bg-warning');
 
 if (isSelected) {
 selectedSeats.push({ id: seatId, price: seatPrice, type: seatType });
 } else {
 selectedSeats = selectedSeats.filter(s => s.id !== seatId);
 }

 // Update UI
 if (selectedSeats.length > 0) {
 displaySpan.innerText = selectedSeats.map(s => s.id).join(', ');
 let total = selectedSeats.reduce((sum, s) => sum + s.price, 0);
 displayTotal.innerText = total.toLocaleString('vi-VN');
 } else {
 displaySpan.innerText = "Chưa chọn ghế";
 displayTotal.innerText = "0";
 }
 });
 });

 btnCheckout.addEventListener('click', function(e) {
 if (selectedSeats.length === 0) {
 e.preventDefault(); 
 // Popup cảnh báo bằng SweetAlert2
 Swal.fire({
 icon: 'warning',
 title: 'Chưa chọn ghế!',
 text: 'Bạn vui lòng chọn ít nhất 1 chỗ ngồi để tiếp tục nhé.',
 background: '#111',
 color: '#fff',
 confirmButtonColor: '#d4af37'
 });
 } else {
 localStorage.setItem('ticketbox_seats', JSON.stringify(selectedSeats));
 }
 });
 });
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.app'); } ?>