<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Đặt Vé Thành Công - Ticket Box'); ?>

<?php $this->startSection('content'); ?>
<div class="row justify-content-center">
 <div class="col-md-6">
 <div class="text-center mb-4">
 <!-- Icon success (Màu xanh) -->
 <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="#28a745" class="bi bi-check-circle-fill mb-3" viewBox="0 0 16 16">
 <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
 </svg>
 <h2 class="text-warning">ĐẶT VÉ THÀNH CÔNG!</h2>
 <p class="text-muted">Cảm ơn bạn đã sử dụng dịch vụ của Ticket Box. Mã vé đã được gửi vào Email và Số điện thoại của bạn.</p>
 </div>

 <!-- Chi tiết vé hiển thị ra -->
 <div class="card glass border-warning text-white shadow-lg">
 <div class="card-header bg-warning text-dark fw-bold text-center border-0">
 MÃ VÉ: TKB-9823471
 </div>
 <div class="card-body p-4 text-center">
 <!-- Mô phỏng mã QR -->
 <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=TKB-9823471&bgcolor=ffffff&color=000000" alt="QR Code" class="mb-4 rounded p-1 bg-white">
 
 <h4 class="card-title fw-bold text-warning mb-3">SIÊU ANH HÙNG TRỞ LẠI</h4>
 
 <div class="row text-start mb-3">
 <div class="col-6 text-muted">Rạp:</div>
 <div class="col-6 fw-bold">Ticket Box - Quận 1</div>
 </div>
 <div class="row text-start mb-3">
 <div class="col-6 text-muted">Suất chiếu:</div>
 <div class="col-6 fw-bold text-warning">19:30 | Hôm nay</div>
 </div>
 <div class="row text-start mb-3">
 <div class="col-6 text-muted">Phòng chiếu:</div>
 <div class="col-6 fw-bold">Cinema 03</div>
 </div>
 <div class="row text-start mb-3 pb-3 border-bottom border-secondary">
 <div class="col-6 text-muted">Ghế:</div>
 <div class="col-6 fw-bold text-danger fs-5" id="success-seats">Đang tải...</div>
 </div>

 <div class="row text-start mt-3">
 <div class="col-6">TỔNG ĐÃ THANH TOÁN:</div>
 <div class="col-6 fw-bold text-success fs-5"><span id="success-total">0</span> VNĐ</div>
 </div>
 </div>
 <div class="card-footer bg-dark text-muted text-center border-top border-secondary">
 <small>Vui lòng xuất trình mã QR này tại quầy vé trước 15 phút.</small>
 </div>
 </div>

 <div class="text-center mt-4">
 <a href="/ASSGD1/" class="btn btn-outline-warning me-2">Về Trang Chủ</a>
 <a href="/ASSGD1/movies" class="btn btn-warning fw-bold">Mua Thêm Vé</a>
 </div>
 </div>
</div>

<script>
 document.addEventListener("DOMContentLoaded", function() {
 let seatsData = JSON.parse(localStorage.getItem('ticketbox_seats')) || [];

 // Hiển thị thông tin vé
 let seatNames = seatsData.map(s => s.id).join(', ') || 'Không có ghế';
 document.getElementById('success-seats').innerText = seatNames;

 let total = seatsData.reduce((sum, s) => sum + s.price, 0);
 document.getElementById('success-total').innerText = total.toLocaleString('vi-VN');

 // Lưu đơn vào lịch sử nếu có ghế và chưa lưu lần này (tránh lưu trùng khi F5)
 if (seatsData.length > 0) {
 let orders = JSON.parse(localStorage.getItem('ticketbox_orders')) || [];

 // Tạo đối tượng đơn đặt vé
 let newOrder = {
 id: 'TKB-' + Math.floor(Math.random() * 9000000 + 1000000),
 movie: 'SIÊU ANH HÙNG TRỞ LẠI',
 cinema: 'Ticket Box - Quận 1',
 showtime: '19:30',
 date: new Date().toLocaleDateString('vi-VN'),
 room: 'Cinema 03',
 seats: seatsData,
 total: total,
 bookedAt: Date.now()
 };

 orders.unshift(newOrder); // Thêm mới nhất lên đầu
 localStorage.setItem('ticketbox_orders', JSON.stringify(orders));

 // Xóa ghế tạm để tránh lưu trùng khi F5
 localStorage.removeItem('ticketbox_seats');

 // Cập nhật mã vé và QR theo ID thật
 document.querySelector('.card-header').innerText = 'MÃ VÉ: ' + newOrder.id;
 let qrImg = document.querySelector('img[alt="QR Code"]');
 if (qrImg) {
 qrImg.src = 'https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + newOrder.id + '&bgcolor=ffffff&color=000000';
 }
 }
 });
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.app'); } ?>