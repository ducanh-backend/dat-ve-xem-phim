<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Thanh Toán - Ticket Box'); ?>

<?php $this->startSection('content'); ?>
<h2 class="mb-4 text-warning border-bottom border-secondary pb-2">XÁC NHẬN THANH TOÁN</h2>

<div class="row">
 <!-- Form thông tin -->
 <div class="col-md-7 mb-4">
 <div class="glass p-4 rounded border-0">
 <h5 class="text-white mb-4">Thông tin người đặt</h5>
 <form id="checkout-form">
 <div class="mb-3">
 <label class="form-label text-muted">Họ và tên</label>
 <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Nhập tên của bạn" required>
 </div>
 <div class="mb-3">
 <label class="form-label text-muted">Số điện thoại</label>
 <input type="tel" class="form-control bg-dark text-white border-secondary" placeholder="Nhập SĐT" required>
 </div>
 <div class="mb-3">
 <label class="form-label text-muted">Email</label>
 <input type="email" class="form-control bg-dark text-white border-secondary" placeholder="Nhập Email để nhận vé" required>
 </div>
 <div class="mb-4">
 <label class="form-label text-muted">Phương thức thanh toán</label>
 <select class="form-select bg-dark text-white border-secondary">
 <option>Thẻ ATM Nội địa / Internet Banking</option>
 <option>Ví điện tử Momo</option>
 <option>Ví ZaloPay</option>
 <option>Thẻ Quốc tế (Visa/Mastercard)</option>
 </select>
 </div>
 <button type="submit" id="btn-confirm-checkout" class="btn btn-warning w-100 fw-bold py-3">XÁC NHẬN ĐẶT VÉ</button>
 </form>
 </div>
 </div>

 <!-- Hóa đơn tóm tắt -->
 <div class="col-md-5">
 <div class="card glass border-warning text-white">
 <div class="card-header bg-warning text-dark fw-bold text-center border-0">
 THÔNG TIN VÉ
 </div>
 <div class="card-body">
 <h5 class="card-title fw-bold">SIÊU ANH HÙNG TRỞ LẠI</h5>
 <p class="card-text text-muted mb-4">2D Lồng Tiếng</p>
 
 <div class="d-flex justify-content-between mb-2">
 <span class="text-muted">Rạp:</span>
 <strong>Ticket Box - Quận 1</strong>
 </div>
 <div class="d-flex justify-content-between mb-2">
 <span class="text-muted">Suất chiếu:</span>
 <strong>19:30 | Hôm nay</strong>
 </div>
 <div class="d-flex justify-content-between mb-2">
 <span class="text-muted">Phòng chiếu:</span>
 <strong>Cinema 03</strong>
 </div>
 <div class="d-flex justify-content-between mb-2">
 <span class="text-muted">Ghế đã chọn:</span>
 <strong class="text-warning" id="checkout-seats">Đang tải...</strong>
 </div>
 <div class="d-flex justify-content-between mb-4 pb-3 border-bottom border-secondary" id="checkout-breakdown">
 <!-- Sẽ chèn chi tiết vé VIP/Thường bằng JS -->
 </div>

 <div class="d-flex justify-content-between align-items-center">
 <span>TỔNG TIỀN:</span>
 <h3 class="text-warning mb-0"><span id="checkout-total">0</span> VNĐ</h3>
 </div>
 </div>
 </div>
 </div>
</div>

<script>
 document.addEventListener("DOMContentLoaded", function() {
 let seatsData = JSON.parse(localStorage.getItem('ticketbox_seats')) || [];
 
 if (seatsData.length === 0) {
 Swal.fire('Lỗi', 'Bạn chưa chọn ghế nào', 'error').then(() => {
 window.location.href = "/ASSGD1/booking/seat";
 });
 return;
 }

 // Render tên ghế
 let seatNames = seatsData.map(s => s.id).join(', ');
 document.getElementById('checkout-seats').innerText = seatNames;
 
 // Render chi tiết
 let breakdownHTML = '';
 seatsData.forEach(s => {
 breakdownHTML += `<div class="w-100 text-end small text-muted">${s.id} (${s.type}): ${s.price.toLocaleString('vi-VN')} đ</div>`;
 });
 document.getElementById('checkout-breakdown').innerHTML = breakdownHTML;

 // Tính tổng tiền
 let total = seatsData.reduce((sum, s) => sum + s.price, 0);
 document.getElementById('checkout-total').innerText = total.toLocaleString('vi-VN');

 // Bắt sự kiện thanh toán mô phỏng loading
 document.getElementById('checkout-form').addEventListener('submit', function(e) {
 e.preventDefault();
 
 Swal.fire({
 title: 'Đang xử lý giao dịch...',
 html: 'Vui lòng không đóng trình duyệt.',
 allowOutsideClick: false,
 background: '#111',
 color: '#fff',
 didOpen: () => {
 Swal.showLoading();
 }
 });

 setTimeout(() => {
 window.location.href = "/ASSGD1/booking/success";
 }, 2500); // Giả lập loading 2.5s
 });
 });
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.app'); } ?>