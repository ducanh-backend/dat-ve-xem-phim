 <option>Ví ZaloPay</option>
 <option>Thẻ Quốc tế (Visa/Mastercard)</option>
 </select>
 </div>
 <a href="/ASSGD1/booking/success" class="btn btn-warning w-100 fw-bold py-3">XÁC NHẬN ĐẶT VÉ</a>
 </form>
 </div>
 </div>

 <!-- Hóa đơn tóm tắt -->
