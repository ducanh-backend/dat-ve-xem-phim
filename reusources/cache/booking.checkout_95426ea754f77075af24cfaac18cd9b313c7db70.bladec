 <span class="text-muted">Phòng chiếu:</span>
 <strong>Cinema 03</strong>
 </div>
 <div class="d-flex justify-content-between mb-4 pb-3 border-bottom border-secondary">
 <span class="text-muted">Ghế:</span>
 <strong class="text-warning" id="checkout-seats">Đang tải...</strong>
 </div>

 <div class="d-flex justify-content-between align-items-center">
 <span>TỔNG TIỀN:</span>
 <h3 class="text-warning mb-0"><span id="checkout-total">0</span> VNĐ</h3>
 </div>
 </div>
 </div>
 </div>
</div>

<script>
 document.addEventListener("DOMContentLoaded", function() {
 // Lấy dữ liệu ghế từ Local Storage
 let seats = JSON.parse(localStorage.getItem('ticketbox_seats')) || ['D5', 'D6'];
 
 // Cập nhật tên ghế
 document.getElementById('checkout-seats').innerText = seats.join(', ');
 
 // Tính tiền (Giả sử 1 vé = 90.000đ)
 let total = seats.length * 90000;
 document.getElementById('checkout-total').innerText = total.toLocaleString('vi-VN');
 });
</script>
<?php $this->stopSection(); ?>

