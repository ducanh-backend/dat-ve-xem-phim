<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Quản Lý Phim - Admin Ticket Box'); ?>
<?php $this->startSection('page_title', 'DANH SÁCH TẤT CẢ PHIM'); ?>

<?php $this->startSection('content'); ?>
<div class="card card-custom p-4 shadow-sm">
 <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
 <div>
 <h5 class="text-dark mb-1 fw-bold">Danh Sách Phim Trong Rạp</h5>
 <span class="text-secondary small">Tổng cộng: <strong class="text-primary"><?php echo \htmlentities(count($movies)??'', ENT_QUOTES, 'UTF-8', false); ?></strong> bộ phim</span>
 </div>
 <?php if(($_SESSION['user']['role'] ?? '') === 'admin'): ?>
 <a href="/ASSGD1/admin/movies/create" class="btn btn-warning fw-bold text-white shadow-sm">
 <i class="bi bi-plus-circle-fill me-1"></i> Thêm Phim Mới
 </a>
 <?php else: ?>
 <span class="badge bg-secondary p-2"><i class="bi bi-eye-fill me-1"></i> Quyền Xem Dữ Liệu</span>
 <?php endif; ?>
 </div>

 <div class="table-responsive">
 <table class="table table-dark-custom table-hover align-middle mb-0">
 <thead>
 <tr>
 <th style="width: 70px;">ID</th>
 <th style="width: 100px;">Poster</th>
 <th>Tên Phim</th>
 <th>Thể Loại</th>
 <th>Thời Lượng</th>
 <th>Trạng Thái</th>
 <th style="width: 180px;" class="text-center">Thao Tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($movies)): ?>
 <tr>
 <td colspan="7" class="text-center text-secondary py-5">
 <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
 Chưa có bộ phim nào được tạo. Hãy nhấn "Thêm Phim Mới" ở trên!
 </td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $movies; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $movie): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $posterUrl = poster_url($movie->poster);
 ?>
 <tr>
 <td class="text-secondary fw-semibold">#<?php echo \htmlentities($movie->id??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if(!empty($movie->poster)): ?>
 <img src="<?php echo \htmlentities($posterUrl??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($movie->title??'', ENT_QUOTES, 'UTF-8', false); ?>" class="rounded shadow-sm" style="width: 60px; height: 85px; object-fit: cover; border: 1.5px solid var(--border-color);">
 <?php else: ?>
 <div class="rounded d-flex align-items-center justify-content-center text-muted small bg-light" style="width: 60px; height: 85px; border: 1px dashed var(--border-color);">
 No pic
 </div>
 <?php endif; ?>
 </td>
 <td>
 <strong class="text-dark fs-6 d-block"><?php echo \htmlentities($movie->title??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 <span class="text-muted small">Đạo diễn: <?php echo \htmlentities($movie->director ?? 'N/A'??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </td>
 <td>
 <span class="badge bg-secondary"><?php echo \htmlentities($movie->category_name ?? 'Chưa phân loại'??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </td>
 <td class="text-dark fw-medium"><?php echo \htmlentities($movie->duration??'', ENT_QUOTES, 'UTF-8', false); ?> phút</td>
 <td>
 <?php if($movie->status === 'dang_chieu'): ?>
 <span class="badge bg-success">Đang chiếu</span>
 <?php elseif($movie->status === 'sap_chieu'): ?>
 <span class="badge bg-info">Sắp chiếu</span>
 <?php else: ?>
 <span class="badge bg-danger">Ngừng chiếu</span>
 <?php endif; ?>
 </td>
 <td class="text-center">
 <?php if(($_SESSION['user']['role'] ?? '') === 'admin'): ?>
 <a href="/ASSGD1/admin/movies/edit/<?php echo \htmlentities($movie->id??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-outline-warning me-1">
 <i class="bi bi-pencil-square me-1"></i> Sửa
 </a>
 <a href="/ASSGD1/admin/movies/delete/<?php echo \htmlentities($movie->id??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 class="btn btn-sm btn-outline-danger" 
 onclick="return confirm('Bạn có chắc chắn muốn xóa phim [<?php echo \htmlentities($movie->title??'', ENT_QUOTES, 'UTF-8', false); ?>]?')">
 <i class="bi bi-trash me-1"></i> Xóa
 </a>
 <?php else: ?>
 <span class="text-muted small"><i class="bi bi-lock-fill me-1"></i> Chỉ xem</span>
 <?php endif; ?>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('admin.layout.app'); } ?>