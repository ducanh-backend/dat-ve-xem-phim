<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Thêm Mới Thể Loại - Admin Ticket Box'); ?>
<?php $this->startSection('page_title', 'THÊM MỚI THỂ LOẠI'); ?>

<?php $this->startSection('content'); ?>
<div class="row justify-content-center">
 <div class="col-md-8">
 <div class="card card-custom p-4">
 <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
 <h5 class="text-warning mb-0 fw-bold">Thông tin thể loại mới</h5>
 <a href="/ASSGD1/admin/categories" class="btn btn-outline-warning btn-sm">
 <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
 </a>
 </div>

 <form action="/ASSGD1/admin/categories/store" method="POST">
 <div class="mb-3">
 <label class="form-label">Tên Thể Loại <span class="text-danger">*</span></label>
 <input type="text" name="name" class="form-control <?php echo \htmlentities(!empty($error['name']) ? 'is-invalid' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 placeholder="VD: Hoạt Hình, Hài Hước..." value="<?php echo \htmlentities($posts['name'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 <?php if(!empty($error['name'])): ?>
 <div class="invalid-feedback"><?php echo \htmlentities($error['name']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </div>

 <div class="mb-3">
 <label class="form-label">Slug (Đường dẫn tĩnh)</label>
 <input type="text" name="slug" class="form-control" 
 placeholder="VD: hoat-hinh (để trống sẽ tự động tạo từ tên)" value="<?php echo \htmlentities($posts['slug'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="form-text text-muted small mt-1">Để trống hệ thống sẽ tự sinh slug chuẩn SEO.</div>
 </div>

 <div class="mb-4">
 <label class="form-label">Mô Tả Thể Loại</label>
 <textarea name="description" rows="3" class="form-control" 
 placeholder="Mô tả ngắn gọn về đặc trưng thể loại..."><?php echo \htmlentities($posts['description'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>

 <button type="submit" class="btn btn-warning fw-bold px-4">
 <i class="bi bi-check2-circle me-1"></i> Lưu Thể Loại
 </button>
 </form>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('admin.layout.app'); } ?>