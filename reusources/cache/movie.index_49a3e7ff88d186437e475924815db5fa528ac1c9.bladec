 </span>
</div>

<div class="row">
 <!-- Sidebar Bộ lọc -->
 <div class="col-md-3 mb-4">
 <div class="filter-box">
 <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">
 <i class="bi bi-funnel-fill text-primary me-2"></i> Lọc Thể Loại
 </h5>
 <?php if(empty($categories)): ?>
 <p class="text-muted small mb-0">Không có thể loại nào.</p>
 <?php else: ?>
 <div class="d-flex flex-column gap-2">
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $cat): $loop = $this->incrementLoopIndices();  ?>
 <div class="form-check p-2 rounded bg-light border">
 <input class="form-check-input filter-checkbox ms-0 me-2" type="checkbox" value="<?php echo \htmlentities($cat->slug ?? $cat->id??'', ENT_QUOTES, 'UTF-8', false); ?>" id="filter<?php echo \htmlentities($cat->id??'', ENT_QUOTES, 'UTF-8', false); ?>" checked>
 <label class="form-check-label fw-semibold text-dark cursor-pointer" for="filter<?php echo \htmlentities($cat->id??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($cat->name??'', ENT_QUOTES, 'UTF-8', false); ?>

 </label>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
 <?php endif; ?>
 </div>
 </div>

 <!-- Danh sách phim -->
 <div class="col-md-9">
 <div class="row row-cols-1 row-cols-md-3 g-4" id="movie-list">
 <?php if(empty($movies)): ?>
 <div class="col-12 text-center text-secondary py-5">
 <i class="bi bi-film fs-1 text-muted d-block mb-3"></i>
 <h5>Hiện chưa có bộ phim nào trong rạp.</h5>
 <p class="text-muted">Vui lòng quay lại sau hoặc liên hệ quản trị viên.</p>
 </div>
 <?php else: ?>
 <?php $__currentLoopData = $movies; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $movie): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $posterUrl = poster_url($movie->poster);
 ?>
 <div class="col movie-item" data-category="<?php echo \htmlentities($movie->category_slug ?? ($movie->category_id ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="card h-100 movie-card">
 <div class="position-relative overflow-hidden">
 <img src="<?php echo \htmlentities($posterUrl??'', ENT_QUOTES, 'UTF-8', false); ?>" class="card-img-top" alt="<?php echo \htmlentities($movie->title??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <span class="badge bg-primary position-absolute top-0 end-0 m-3 shadow-sm">
 <?php echo \htmlentities($movie->duration ?? 120??'', ENT_QUOTES, 'UTF-8', false); ?>'
 </span>
 </div>
 <div class="card-body">
 <div>
 <h6 class="card-title text-truncate fw-bold" title="<?php echo \htmlentities($movie->title??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($movie->title??'', ENT_QUOTES, 'UTF-8', false); ?></h6>
 <p class="card-text">
 <span class="badge bg-light text-secondary border">
 <i class="bi bi-tag-fill text-primary me-1 small"></i><?php echo \htmlentities($movie->category_name ?? 'Phim chiếu rạp'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </p>
 </div>
 <a href="/ASSGD1/movie/<?php echo \htmlentities($movie->id??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-warning w-100">
 <i class="bi bi-ticket-perforated me-1"></i> Chi Tiết / Đặt Vé
 </a>
 </div>
 </div>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </div>
 </div>
</div>

<script>
 // Xử lý Lọc phim Live (Live Filter)
 document.addEventListener("DOMContentLoaded", function() {
 const checkboxes = document.querySelectorAll('.filter-checkbox');
 const movies = document.querySelectorAll('.movie-item');

 checkboxes.forEach(chk => {
 chk.addEventListener('change', function() {
 let checkedCategories = Array.from(checkboxes).filter(i => i.checked).map(i => i.value);
 
 movies.forEach(movie => {
 let movieCategories = (movie.getAttribute('data-category') || '').split(' ');
 let isVisible = movieCategories.some(cat => checkedCategories.includes(cat));
 
 if (isVisible) {
 movie.style.display = 'block';
 } else {
 movie.style.display = 'none';
 }
 });
 });
 });
 });
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.app'); } ?>