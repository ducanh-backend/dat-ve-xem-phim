<script>
 // Xử lý Lọc phim Live (Live Filter)
 document.addEventListener("DOMContentLoaded", function() {
 const checkboxes = document.querySelectorAll('.filter-checkbox');
 const movies = document.querySelectorAll('.movie-item');

 checkboxes.forEach(chk => {
 chk.addEventListener('change', function() {
 // Lấy danh sách các thể loại đang được check
 let checkedCategories = Array.from(checkboxes).filter(i => i.checked).map(i => i.value);
 
 movies.forEach(movie => {
 let movieCategories = movie.getAttribute('data-category').split(' ');
 // Kiểm tra xem phim này có thuộc thể loại đang check không
 let isVisible = movieCategories.some(cat => checkedCategories.includes(cat));
 
 if (isVisible) {
 movie.style.display = 'block';
 movie.classList.add('fade-in-up'); // Thêm hiệu ứng hiện lại
 } else {
 movie.style.display = 'none';
 movie.classList.remove('fade-in-up');
 }
 });
 });
 });
 });
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.app'); } ?>