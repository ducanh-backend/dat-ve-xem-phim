<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Cập Nhật Thể Loại - Admin Ticket Box'); ?>
<?php $this->startSection('page_title', 'CẬP NHẬT THỂ LOẠI'); ?>

<?php $this->startSection('content'); ?>
<div class="row justify-content-center">
 <div class="col-md-8">
 <div class="card card-custom p-4">
 <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
 <h5 class="text-warning mb-0 fw-bold">Chỉnh sửa thể loại: <?php echo \htmlentities($category->name??'', ENT_QUOTES, 'UTF-8', false); ?></h5>
 <a href="/ASSGD1/admin/categories" class="btn btn-outline-warning btn-sm">
 <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
 </a>
 </div>

 <form action="/ASSGD1/admin/categories/edit/<?php echo \htmlentities($category->id??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <div class="mb-3">
 <label class="form-label">Tên Thể Loại <span class="text-danger">*</span></label>
 <input type="text" name="name" class="form-control <?php echo \htmlentities(!empty($error['name']) ? 'is-invalid' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 value="<?php echo \htmlentities($posts['name'] ?? $category->name??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 <?php if(!empty($error['name'])): ?>
 <div class="invalid-feedback"><?php echo \htmlentities($error['name']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </div>

 <div class="mb-3">
 <label class="form-label">Slug (Đường dẫn tĩnh)</label>
 <input type="text" name="slug" class="form-control" 
 value="<?php echo \htmlentities($posts['slug'] ?? $category->slug??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>

 <div class="mb-4">
 <label class="form-label">Mô Tả Thể Loại</label>
 <textarea name="description" rows="3" class="form-control"><?php echo \htmlentities($posts['description'] ?? $category->description??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>

 <button type="submit" class="btn btn-warning fw-bold px-4">
 <i class="bi bi-save me-1"></i> Cập Nhật Thể Loại
 </button>
 </form>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('admin.layout.app'); } ?>