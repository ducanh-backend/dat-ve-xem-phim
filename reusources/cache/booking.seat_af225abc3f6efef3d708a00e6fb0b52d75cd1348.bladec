<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Chọn Ghế - Ticket Box'); ?>

<?php $this->startSection('content'); ?>
<div class="text-center mb-4">
 <h2 class="fw-bold mb-1 text-dark d-flex align-items-center justify-content-center">
 <i class="bi bi-ticket-perforated-fill text-primary me-2"></i> CHỌN GHẾ NGỒI XEM PHIM
 </h2>
 <p class="text-secondary">Phim: <strong class="text-dark">SIÊU ANH HÙNG TRỞ LẠI</strong> | Suất chiếu: <strong class="text-primary">19:30 - Hôm nay</strong></p>
</div>

<div class="row justify-content-center">
 <div class="col-md-9">
 <div class="card card-custom p-4 p-md-5 shadow-sm">
 <!-- Màn hình chiếu sáng Neon Hiện Đại -->
 <div class="screen-glow"></div>
 <div class="text-center fw-bold mb-5 fs-6 text-uppercase" style="letter-spacing: 3px; color: #6366f1;">
 <i class="bi bi-display me-1"></i> MÀN HÌNH CHÍNH (SCREEN)
 </div>

 <!-- Sơ đồ ghế -->
 <div class="d-flex flex-column align-items-center gap-2 overflow-auto pb-3">
 <?php $__currentLoopData = ['A', 'B', 'C', 'D', 'E']; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $row): $loop = $this->incrementLoopIndices();  ?>
 <div class="d-flex gap-2 align-items-center">
 <strong class="text-primary me-3 text-center" style="width: 20px;"><?php echo \htmlentities($row??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 <?php for($col = 1; $col <= 10; $col++): ?>
 <?php 
 $isVIP = ($row == 'C' || $row == 'D');
 $price = $isVIP ? 120000 : 90000;
 $seatStyle = $isVIP ? 'background: #eef2ff; border-color: #818cf8; color: #4338ca;' : 'background: #f8fafc; border-color: #cbd5e1; color: #334155;';
 $isBooked = ($row == 'B' && $col == 5) || ($row == 'C' && $col == 7) || ($row == 'D' && $col == 4);
 ?>

 <?php if($isBooked): ?>
 <div class="seat rounded-3 text-center fw-bold d-flex align-items-center justify-content-center" 
 style="width: 40px; height: 40px; background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; opacity: 0.7; cursor: not-allowed; font-size: 13px;">
 <i class="bi bi-x-lg"></i>
 </div>
 <?php else: ?>
 <div class="seat seat-available rounded-3 text-center d-flex align-items-center justify-content-center border" 
 data-seat="<?php echo \htmlentities($row??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities($col??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 data-price="<?php echo \htmlentities($price??'', ENT_QUOTES, 'UTF-8', false); ?>"
 data-type="<?php echo \htmlentities($isVIP ? 'VIP' : 'Thường'??'', ENT_QUOTES, 'UTF-8', false); ?>"
 style="width: 40px; height: 40px; cursor: pointer; font-size: 13px; font-weight: 700; <?php echo \htmlentities($seatStyle??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($col??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 <?php endif; ?>
 <?php endfor; ?>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>

 <!-- Chú thích -->
 <div class="d-flex justify-content-center flex-wrap gap-4 mt-5 p-3 rounded-3 bg-light border">
 <div class="d-flex align-items-center text-secondary small">
 <div class="rounded me-2 border" style="width: 22px; height: 22px; background: #f8fafc; border-color: #cbd5e1 !important;"></div> 
 Ghế Thường (90k)
 </div>
 <div class="d-flex align-items-center text-primary small">
 <div class="rounded me-2 border" style="width: 22px; height: 22px; background: #eef2ff; border-color: #818cf8 !important;"></div> 
 Ghế VIP (120k)
 </div>
 <div class="d-flex align-items-center text-dark small fw-bold">
 <div class="rounded me-2" style="width: 22px; height: 22px; background: var(--brand-gradient);"></div> 
 Đang chọn
 </div>
 <div class="d-flex align-items-center text-danger small">
 <div class="rounded me-2" style="width: 22px; height: 22px; background: #fee2e2; border: 1px solid #fca5a5;"></div> 
 Đã bán
 </div>
 </div>
 
 <!-- Hiển thị ghế đang chọn -->
 <div class="mt-4 p-4 rounded-4 text-center bg-light border" style="border-color: #c7d2fe !important;">
 <div class="text-secondary mb-1">Ghế đang chọn: <strong id="selected-seats-display" class="text-primary fs-5">Chưa chọn ghế</strong></div>
 <div class="text-dark">Tạm tính: <strong id="temp-total" class="text-primary fs-3">0</strong> <span class="text-primary fw-bold">đ</span></div>
 </div>

 <div class="d-flex justify-content-center gap-3 mt-4">
 <a href="/ASSGD1/movies" class="btn btn-outline-secondary px-4">
 <i class="bi bi-arrow-left me-1"></i> Chọn Phim Khác
 </a>
 <a href="/ASSGD1/booking/checkout" id="btn-checkout" class="btn btn-warning px-5 fw-bold shadow text-white">
 TIẾP TỤC THANH TOÁN <i class="bi bi-arrow-right ms-1"></i>
 </a>
 </div>
 </div>
 </div>
</div>

<script>
 document.addEventListener("DOMContentLoaded", function() {
 const availableSeats = document.querySelectorAll('.seat-available');
 const displaySpan = document.getElementById('selected-seats-display');
 const displayTotal = document.getElementById('temp-total');
 const btnCheckout = document.getElementById('btn-checkout');
 let selectedSeats = [];

 localStorage.removeItem('ticketbox_seats');

 availableSeats.forEach(seat => {
 seat.addEventListener('click', function() {
 const seatId = this.getAttribute('data-seat');
 const seatPrice = parseInt(this.getAttribute('data-price'));
 const seatType = this.getAttribute('data-type');
 
 this.classList.toggle('bg-warning');
 
 const isSelected = this.classList.contains('bg-warning');
 
 if (isSelected) {
 selectedSeats.push({ id: seatId, price: seatPrice, type: seatType });
 } else {
 selectedSeats = selectedSeats.filter(s => s.id !== seatId);
 }

 // Update UI
 if (selectedSeats.length > 0) {
 displaySpan.innerText = selectedSeats.map(s => s.id).join(', ');
 let total = selectedSeats.reduce((sum, s) => sum + s.price, 0);
 displayTotal.innerText = total.toLocaleString('vi-VN');
 } else {
 displaySpan.innerText = "Chưa chọn ghế";
 displayTotal.innerText = "0";
 }
 });
 });

 btnCheckout.addEventListener('click', function(e) {
 if (selectedSeats.length === 0) {
 e.preventDefault(); 
 Swal.fire({
 icon: 'warning',
 title: 'Chưa chọn ghế!',
 text: 'Bạn vui lòng chọn ít nhất 1 chỗ ngồi để tiếp tục nhé.',
 background: '#ffffff',
 color: '#0f172a',
 confirmButtonColor: '#4f46e5'
 });
 } else {
 localStorage.setItem('ticketbox_seats', JSON.stringify(selectedSeats));
 }
 });
 });
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.app'); } ?>